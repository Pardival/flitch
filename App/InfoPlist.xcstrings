    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flitch n'écoute que pendant que tu maintiens le raccourci pour parler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flitch solo escucha mientras mantienes pulsado el atajo para hablar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flitch listens only while you hold the talk shortcut."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flitch transcrit ta voix sur ton Mac pour comprendre ta question."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flitch transcribe tu voz en tu Mac para entender tu pregunta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flitch transcribes your voice on your Mac to understand your question."
          }
        }
      }
    },
