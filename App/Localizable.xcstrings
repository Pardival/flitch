    "Hi, I'm Flitch": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut, moi c'est Flitch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, soy Flitch"
          }
        }
      }
    },
    "Hold %@ and ask me something, like “Tell me about Napoleon” or “What's in the news today?”": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens %@ et demande-moi quelque chose, par exemple « Parle-moi de Napoléon » ou « Quelle est l'actualité aujourd'hui ? »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado %@ y pregúntame algo, como «Háblame de Napoleón» o «¿Qué noticias hay hoy?»"
          }
        }
      }
    },
    "Hold right ⌥ to talk": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir ⌥ droite pour parler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener ⌥ derecha para hablar"
          }
        }
      }
    },
    "Hold to talk, release to send. macOS will ask for “Input Monitoring”: I never read any other key.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens pour parler, relâche pour envoyer. macOS va demander la « Surveillance de l'entrée » : je ne lis aucune autre touche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para hablar y suelta para enviar. macOS pedirá «Monitorización de entrada»: nunca leo ninguna otra tecla."
          }
        }
      }
    },
    "I have an API key": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai une clé API"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengo una clave API"
          }
        }
      }
    },
    "I only listen while you hold the key. Your voice is transcribed on your Mac and nothing is recorded.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'écoute que pendant que tu maintiens la touche. Ta voix est transcrite sur ton Mac et rien n'est enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo escucho mientras mantienes pulsada la tecla. Tu voz se transcribe en tu Mac y no se graba nada."
          }
        }
      }
    },
    "It's ready!": {
      "extractionState": "manual",
