    "A little otter who lives in a corner of your screen. Hold a key, ask your question, and I answer out loud.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite loutre qui vit dans un coin de ton écran. Maintiens une touche, pose ta question, et je te réponds à voix haute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña nutria que vive en una esquina de tu pantalla. Mantén pulsada una tecla, haz tu pregunta y te respondo en voz alta."
          }
        }
      }
    },
