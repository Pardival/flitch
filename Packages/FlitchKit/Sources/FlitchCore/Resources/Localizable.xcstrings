{
  "sourceLanguage": "en",
  "strings": {
    "listening.title": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je t'écoute"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te escucho"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm listening"
          }
        }
      }
    },
    "listening.hint": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relâche %@ pour envoyer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta %@ para enviar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release %@ to send"
          }
        }
      }
    },
    "thinking.title": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je réfléchis…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy pensando…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking…"
          }
        }
      }
    },
    "speaking.hint": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur %@ pour m'interrompre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ para interrumpirme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ to interrupt"
          }
        }
      }
    },
    "linger.open": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir la réponse complète"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir la respuesta completa"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the full answer"
          }
        }
      }
    },
    "error.noProvider": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'ai pas encore de cerveau ! Connecte une IA dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Todavía no tengo cerebro! Conecta una IA en los ajustes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't have a brain yet! Connect an AI in Settings."
          }
        }
      }
    },
    "error.invalidKey": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma clé %@ a été refusée. Tu peux la vérifier dans les réglages ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi clave de %@ fue rechazada. ¿Puedes revisarla en los ajustes?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My key to %@ was refused. Can you check it in Settings?"
          }
        }
      }
    },
    "error.offline": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'arrive pas à joindre internet pour l'instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no consigo conectarme a internet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't reach the internet right now."
          }
        }
      }
    },
    "error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai beaucoup parlé ! %@ me demande d'attendre un peu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡He hablado mucho! %@ me pide que espere un poco."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've talked a lot! %@ asks me to wait a little."
          }
        }
      }
    },
    "error.micDenied": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne t'entends pas : autorise le micro dans Réglages Système › Confidentialité et sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te oigo: permite el micrófono en Ajustes del Sistema › Privacidad y seguridad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't hear you: allow the microphone in System Settings › Privacy & Security."
          }
        }
      }
    },
    "error.nothingHeard": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hein ? Je n'ai rien entendu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eh? No he oído nada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmm? I didn't hear anything."
          }
        }
      }
    },
    "error.generic": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oups, j'ai eu un souci : %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uy, algo salió mal: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oops, something went wrong: %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}