{
  "formatVersion": 1,
  "id": "otter",
  "name": "Flitch the otter",
  "version": "0.1.0",
  "author": "The Flitch contributors",
  "license": "CC-BY-4.0",
  "frame": { "width": 32, "height": 32 },
  "displayScale": 3,
  "anchors": { "foot": [16, 31], "bubble": [26, 6], "peekEdge": [16, 31] },
  "animations": {
    "idle":   { "file": "idle.png",   "frames": 2, "fps": 0.4, "loop": true },
    "listen": { "file": "listen.png", "frames": 1, "fps": 1,   "loop": true },
    "think":  { "file": "think.png",  "frames": 1, "fps": 1,   "loop": true, "events": { "0": "tap" } },
    "talk":   { "file": "talk.png",   "frames": 4, "fps": 0,   "loop": true, "driver": "audioLevel" },
    "happy":  { "file": "happy.png",  "frames": 1, "fps": 1,   "loop": false },
    "wave":   { "file": "wave.png",   "frames": 1, "fps": 1,   "loop": false },
    "sleep":  { "file": "sleep.png",  "frames": 1, "fps": 1,   "loop": true },
    "peek":   { "file": "peek.png",   "frames": 1, "fps": 1,   "loop": false }
  },
  "behaviour": {
    "idle": [["juggle", 0.5], ["groom", 0.3], ["dance", 0.2]],
    "sleepAfter": 180
  },
  "voice": {
    "animal": { "pitch": 520, "timbre": "squeak", "speed": 1.1, "randomness": 0.18 }
  }
}
